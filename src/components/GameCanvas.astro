---
// Generic Canvas2D game island. Two shapes:
//
//   <GameCanvas game="treasure-hunt" />          → launch trigger + palm overlay
//   <GameCanvas game="treasure-hunt" bare />     → inline canvas (test pages)
//
// The non-bare form renders a quiet "bonus level" easter-egg trigger. Clicking
// it summons the site's hand cursor to the centre of the screen, where it
// grows into a giant open palm. A little device window pops up in the palm's
// centre, boots with a "PALM PILOT" loading screen, and the game appears on
// it. Closing reverses everything: the window pops away, the palm shrinks
// back down to the ordinary hand, and it returns to idle.
//
// HandCursor.astro plays the hand's side; the two are coordinated through
// bonus:* document events:
//
//   bonus:open        host → hand    overlay opening — fly to centre screen
//   bonus:hand-ready  hand → host    at the centre (hand hides; palm takes over)
//   bonus:close       host → hand    closing — stand by
//   bonus:closed      hand ← host    palm is gone; reappear at centre and idle
//
// Every step has a timeout fallback, so the overlay works even when the hand
// is busy navigating or reduced motion is on.

import { getGame } from '../games/manifest';
import { emojiSvgUrl } from '../games/emoji';

interface Props {
  game: string;
  /** Invitation line on the launch button (and the in-game intro card). */
  prompt?: string;
  /** Per-instance option overrides merged over the manifest defaults. */
  options?: Record<string, unknown>;
  /** Skip the launch/overlay chrome — used on the standalone test pages. */
  bare?: boolean;
}

const { game, prompt, options: overrides, bare = false } = Astro.props;
const meta = getGame(game);
if (!meta) throw new Error(`Unknown game: "${game}". Add it to src/games/manifest.ts`);

const options = {
  ...(meta.options ?? {}),
  ...(overrides ?? {}),
  title: meta.title,
  instructions: prompt ?? meta.description,
};
const badge = meta.badge ?? null;
const domId = `game-${badge?.id ?? meta.id}`;
const icon = badge?.icon ?? String(options.target ?? '🏆');
const iconSvg = emojiSvgUrl(icon); // bundled SVG when we have one, else the glyph
---

<section
  class:list={['game-embed', bare && 'is-bare']}
  id={domId}
  data-game={meta.id}
  data-options={JSON.stringify(options)}
  data-badge={badge ? JSON.stringify(badge) : undefined}
  style={`--aspect:${meta.aspect}`}
  aria-label={`${meta.title} minigame`}
>
  {bare ? (
    <div class="game-embed-stage">
      <canvas class="game-embed-canvas" aria-label={meta.description}></canvas>
    </div>
  ) : (
    <>
      <button
        type="button"
        class="game-launch"
        aria-expanded="false"
        aria-controls={`${domId}-overlay`}
        aria-label={`Play the ${meta.title} bonus level`}
      >
        <span class="game-launch-label">bonus level</span>
        <span class="game-launch-icon" aria-hidden="true">
          {iconSvg ? <img src={iconSvg} alt="" /> : icon}
        </span>
      </button>

      {/* Portaled to <body> on wire — .project-panel is a fixed/z-indexed
          stacking context that would trap the overlay under the sidebar.
          --aspect is repeated here since it stops inheriting from the section. */}
      <div class="game-overlay" id={`${domId}-overlay`} style={`--aspect:${meta.aspect}`} hidden>
        <div class="game-overlay-backdrop"></div>
        {/* Palm + screen are one rig that scales together: the screen appears
            on the small hand first, then the whole thing grows. The palm is a
            bundled Fluent Emoji (MIT) rather than a native glyph so its
            proportions and yellow are identical on every platform. */}
        <div class="game-rig">
          <img class="game-palm" src="/ui/hand-fist.svg" alt="" aria-hidden="true" />
          <div class="game-window" role="dialog" aria-modal="true" aria-label={`${meta.title} bonus level`}>
            {/* Close pinned to the screen's top-right corner. */}
            <button type="button" class="game-window-close" aria-label="Close bonus level">
              <svg class="game-window-close-x" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M7 7 L17 17 M17 7 L7 17" />
              </svg>
            </button>
            <div class="game-embed-stage">
              <canvas class="game-embed-canvas" aria-label={meta.description}></canvas>
            </div>
            <div class="game-boot" aria-hidden="true">
              <img class="game-boot-hand" src="/ui/hand-wave.svg" alt="" />
              <span class="game-boot-label">palm pilot</span>
            </div>
          </div>
        </div>
      </div>
    </>
  )}
</section>

<style>
  .game-embed {
    /* the body sections are flex children with a --space-section (5rem) gap;
       pull the quiet bonus trigger up close under the credits block, and pull
       the bottom in too so it sits 1.5rem clear of the page's 2rem padding,
       matching the gap above it */
    margin: calc(1.5rem - var(--space-section)) auto calc(1.5rem - 2rem);
    max-width: 640px;
    text-align: center;
  }

  /* ── the canvas stage ────────────────────────────────────────── */
  .game-embed-stage {
    position: relative;
    width: 100%;
    aspect-ratio: var(--aspect, 1);
    border-radius: 14px;
    overflow: hidden;
    background: #e9e6df;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.14);
  }
  .game-embed-canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none; /* let the game own drags/swipes */
    cursor: none;       /* the game sets its own cursor per phase */
  }

  /* ── launch trigger (quiet easter egg) ───────────────────────── */
  .game-launch {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 auto;
    padding: 0.5rem 0.35rem;
    background: none;
    border: none;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: var(--label-tracking-loose);
    text-transform: lowercase;
    cursor: pointer;
    opacity: 0.5;
    transition: opacity 0.3s ease, color 0.3s ease;
  }
  .game-launch:hover,
  .game-launch:focus-visible,
  .game-launch[aria-expanded='true'] {
    opacity: 1;
    color: var(--color-text);
  }
  .game-launch:focus-visible {
    outline: 1px solid var(--color-border);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }
  .game-launch-icon {
    font-size: 1rem;
    line-height: 1;
    filter: grayscale(1);
    opacity: 0.6;
    transition: filter 0.3s ease, opacity 0.3s ease, transform 0.35s ease;
  }
  .game-launch-icon img {
    display: block;
    width: 1.15rem;
    height: 1.15rem;
  }
  .game-launch:hover .game-launch-icon,
  .game-launch:focus-visible .game-launch-icon,
  .game-launch[aria-expanded='true'] .game-launch-icon {
    filter: none;
    opacity: 1;
    transform: translateY(-2px) rotate(-10deg);
  }
  :global([data-reduced-motion='true']) .game-launch-icon {
    transition: filter 0.3s ease, opacity 0.3s ease;
  }
  :global([data-reduced-motion='true']) .game-launch:hover .game-launch-icon,
  :global([data-reduced-motion='true']) .game-launch:focus-visible .game-launch-icon,
  :global([data-reduced-motion='true']) .game-launch[aria-expanded='true'] .game-launch-icon {
    transform: none;
  }

  /* ── palm overlay ────────────────────────────────────────────── */
  /* Fixed overlay + transform/opacity-only animation: nothing reflows, the
     page never shifts, and the canvas boots while the window is still
     invisible — the hand cursor's rAF loop stays smooth throughout. */
  .game-overlay {
    position: fixed;
    inset: 0;
    z-index: 900; /* above everything but the hand cursor (9999) */
    display: grid;
    place-items: center;
    padding: 1rem;
  }
  .game-overlay[hidden] {
    display: none;
  }
  .game-overlay-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(30, 27, 21, 0.38);
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .game-overlay.is-open .game-overlay-backdrop {
    opacity: 1;
  }

  /* The palm + screen rig — one element the grow/shrink animation scales, so
     the screen is on the hand at every size. Grid-centred with NO transform
     at rest (only `scale()` during the animations, pinned back to none after)
     — a persistent transform would leave the browser compositing a raster
     cached at the tiny start scale, blurring the SVG at full size. The
     margin biases it up so the palm proper (glyph's lower half) sits at
     centre; transform-origin keeps that same point fixed while scaling. */
  .game-rig {
    --rig: min(96vmin, 800px);
    position: absolute;
    /* static centring (no translate): the (50%, 54%) origin point — the palm
       proper — sits exactly at viewport centre, where the hand cursor waits */
    left: calc(50% - var(--rig) / 2);
    top: calc(50% - var(--rig) * 0.54);
    width: var(--rig);
    aspect-ratio: 1;
    transform: scale(0); /* closed pose; JS animates */
    transform-origin: 50% 54%;
    opacity: 0;
  }
  .game-palm {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* the screen is centred on the viewport; the fist is offset a touch up +
       right so the screen falls inside its grip (the window stays put) */
    transform: translate(1%, 1%);
    pointer-events: none;
    user-select: none;
  }

  /* The device screen fills the fist's grip — a big near-circular squircle
     covering the fist's centre, knuckles peeking above and a thin rim of
     hand around the sides and bottom. Tinted in the hand's own yellows
     (Fluent palette: #FFD140 / #E8AD3C / #DF8F0D) with a warm glow, so it
     reads as part of the hand. */
  .game-window {
    position: absolute;
    left: 17%;
    top: 21%;
    width: 66%;
    padding: 8px;
    border-radius: 26%;
    background: linear-gradient(180deg, #ffd93f, #e8ad3c);
    box-shadow:
      0 24px 70px rgba(0, 0, 0, 0.3),
      0 0 46px rgba(255, 200, 60, 0.55),
      inset 0 1px 0 rgba(255, 255, 255, 0.55),
      inset 0 0 0 1px rgba(223, 143, 13, 0.5);
  }
  .game-window .game-embed-stage {
    border-radius: 25%;
    box-shadow: inset 0 0 0 1px rgba(223, 143, 13, 0.35);
  }
  .game-window-close {
    position: absolute;
    top: 1.5%;
    right: 1.5%;
    z-index: 3;
    width: 11.5%;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: linear-gradient(180deg, #fffdf6, #f1e7d0);
    color: #5a3a06;
    /* raised, with the device's amber inset ring + highlight */
    box-shadow:
      0 4px 10px rgba(60, 40, 6, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.7),
      inset 0 0 0 3px rgba(223, 143, 13, 0.65);
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease, color 0.2s ease;
  }
  /* the glyph scales with the button so it stays bold on large screens */
  .game-window-close-x {
    width: 44%;
    height: 44%;
  }
  .game-window-close-x path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.8;
    stroke-linecap: round;
  }
  .game-window-close:hover,
  .game-window-close:focus-visible {
    background: linear-gradient(180deg, #ffffff, #f6eeda);
    color: #3d2a05;
    transform: scale(1.06);
  }
  .game-window-close:focus-visible {
    outline: 2px solid rgba(28, 28, 34, 0.7);
    outline-offset: 2px;
  }

  /* Boot screen over the stage — an amber LCD that "activates", then fades
     to reveal the live game underneath (already mounted and running). */
  .game-boot {
    position: absolute;
    inset: 8px;
    border-radius: 25%;
    background: radial-gradient(circle at 50% 42%, #4a360c, #33240a 78%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    transition: opacity 0.45s ease, visibility 0s 0.45s;
  }
  .game-window.is-live .game-boot {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .game-boot-label {
    color: #ffd140;
    font-family: var(--font-mono);
    font-size: 1.05rem;
    letter-spacing: var(--label-tracking-loose);
    text-transform: lowercase;
  }
  /* a friendly waving hand — the "palm" booting up (bundled SVG, not a glyph) */
  .game-boot-hand {
    width: 2.8rem;
    height: 2.8rem;
    transform-origin: 72% 78%;
    animation: game-boot-wave 1.1s ease-in-out infinite;
  }
  @keyframes game-boot-wave {
    0%, 100% { transform: rotate(-14deg); }
    50% { transform: rotate(18deg); }
  }
  :global([data-reduced-motion='true']) .game-boot-hand {
    animation: none;
  }
</style>

<script>
  import { mountGame } from '../games/engine';
  import type { Game } from '../games/engine';
  import { REGISTRY } from '../games/registry';
  import { awardBadge } from '../utils/badges';

  interface EmbedEl extends HTMLElement {
    _ctrl?: { destroy(): void };
    _game?: Game;
    _growAnim?: Animation | null;
    _shrinkAnim?: Animation | null;
    _overlay?: HTMLElement;
  }

  const HAND_WAIT = 900;   // grow the palm anyway if the hand can't come
  const GROW_MS = 620;     // hand-size → giant palm-with-screen
  const BOOT_MS = 1100;    // "palm pilot" loading beat before the game shows
  const SHRINK_MS = 450;   // giant palm-with-screen → hand-size

  const reduced = () =>
    document.documentElement.getAttribute('data-reduced-motion') === 'true';

  // Per-section sequence number, bumped on every open/close, so async steps
  // from a superseded cycle (event waits, animation finishes) no-op.
  const seqOf = (el: EmbedEl) => Number(el.dataset.seq || 0);
  const bumpSeq = (el: EmbedEl) => {
    el.dataset.seq = String(seqOf(el) + 1);
    return seqOf(el);
  };

  function dispatch(type: string, detail: Record<string, unknown>) {
    document.dispatchEvent(new CustomEvent(type, { detail }));
  }

  /** Resolve with the event detail when a bonus:* event for `id` arrives,
   *  or with null after `ms` — whichever comes first. */
  function eventOrTimeout(type: string, id: string, ms: number): Promise<any | null> {
    return new Promise(resolve => {
      const finish = (detail: any) => {
        document.removeEventListener(type, handler);
        clearTimeout(timer);
        resolve(detail);
      };
      const handler = (e: Event) => {
        const detail = (e as CustomEvent).detail;
        if (detail?.id !== id) return;
        finish(detail);
      };
      const timer = window.setTimeout(() => finish(null), ms);
      document.addEventListener(type, handler);
    });
  }

  /** Current rig scale from its computed transform (0 when hidden). */
  function rigScale(rig: HTMLElement): number {
    const t = getComputedStyle(rig).transform;
    if (!t || t === 'none') return 1;
    return new DOMMatrixReadOnly(t).a;
  }

  /** Await an animation's end, but never longer than its duration + slack —
   *  a stalled/throttled animation must not wedge the sequence. */
  function settle(anim: Animation | null | undefined, ms: number): Promise<void> {
    return Promise.race([
      anim ? anim.finished.then(() => {}, () => {}) : Promise.resolve(),
      new Promise<void>(r => setTimeout(r, ms + 300)),
    ]);
  }

  function partsOf(section: EmbedEl) {
    const overlay = section._overlay ?? null;
    return {
      overlay,
      rig: overlay?.querySelector<HTMLElement>('.game-rig') ?? null,
      win: overlay?.querySelector<HTMLElement>('.game-window') ?? null,
      canvas: (overlay ?? section).querySelector<HTMLCanvasElement>('.game-embed-canvas'),
      launch: section.querySelector<HTMLElement>('.game-launch'),
    };
  }

  // The scale at which the giant palm matches the ordinary hand cursor —
  // the grow starts there and the shrink returns there, so the site hand and
  // the rig swap seamlessly.
  function handScale(rig: HTMLElement) {
    const handPx = document.getElementById('hand-cursor')?.offsetHeight || 36;
    return handPx / Math.max(1, rig.offsetHeight);
  }

  // Mount the canvas game (idempotent).
  function mount(el: EmbedEl, canvas: HTMLCanvasElement | null) {
    if (el.dataset.ready === 'true') return;
    const id = el.dataset.game;
    if (!id || !canvas) return;
    const factory = REGISTRY[id];
    if (!factory) {
      console.warn(`No registered game "${id}"`);
      return;
    }
    el.dataset.ready = 'true';

    const options = JSON.parse(el.dataset.options || '{}');
    const badge = el.dataset.badge ? JSON.parse(el.dataset.badge) : null;

    const game = factory({
      ...options,
      badge: badge ?? undefined,
      onWin: () => {
        // link back to the top of the project page (not the deep game anchor)
        if (badge) awardBadge({ ...badge, href: location.pathname });
      },
    });

    el._game = game;
    el._ctrl = mountGame(canvas, game, { background: '#e9e6df' });
  }

  function unmount(el: EmbedEl) {
    el._ctrl?.destroy();
    el._ctrl = undefined;
    el._game = undefined;
    el._growAnim?.cancel();
    el._growAnim = null;
    el._shrinkAnim?.cancel();
    el._shrinkAnim = null;
    el.dataset.ready = '';
  }

  async function open(section: EmbedEl) {
    if (section.dataset.open === 'true') return;
    section.dataset.open = 'true';
    const mySeq = bumpSeq(section);
    const { overlay, rig, win, canvas, launch } = partsOf(section);
    if (!overlay || !rig || !win) return;

    launch?.setAttribute('aria-expanded', 'true');
    overlay.hidden = false;
    requestAnimationFrame(() => overlay.classList.add('is-open'));
    // Dispatch FIRST so the hand starts moving on the same click — the game
    // boots later, behind the compositor-driven grow, where its main-thread
    // cost can't stutter anything.
    dispatch('bonus:open', { id: section.id });

    if (reduced()) {
      // No theatrics: rig in place, game showing.
      mount(section, canvas);
      rig.style.opacity = '1';
      rig.style.transform = 'none';
      win.classList.add('is-live');
      canvas?.focus({ preventScroll: true });
      return;
    }

    // Wait for the hand to reach centre screen (or grow without it).
    await eventOrTimeout('bonus:hand-ready', section.id, HAND_WAIT);
    if (seqOf(section) !== mySeq) return;

    // The rig takes over from the hand at the same size — screen already on
    // the palm — and grows at once, no hold. WAAPI transform animations run
    // on the compositor, so the game mount right after can't make them
    // stutter.
    const small = handScale(rig);
    rig.style.transform = `scale(${small})`;
    rig.style.opacity = '1';
    section._growAnim?.cancel();
    try {
      section._growAnim = rig.animate(
        [
          { transform: `scale(${small})` },
          { transform: 'scale(1)' },
        ],
        { duration: GROW_MS, easing: 'cubic-bezier(0.34, 1.3, 0.64, 1)', fill: 'forwards' },
      );
    } catch {
      section._growAnim = null; // animation API hiccup — snap to grown below
    }
    mount(section, canvas); // boots behind the opaque boot face, mid-grow
    await settle(section._growAnim, GROW_MS);
    if (seqOf(section) !== mySeq) return;
    // Rest with NO transform: forces a fresh crisp raster of the SVG at full
    // size (a lingering scale keeps the compositor's tiny cached texture).
    rig.style.transform = 'none';
    section._growAnim?.cancel();
    section._growAnim = null;

    // "palm pilot" loading beat, then the game appears on the screen.
    await new Promise(r => setTimeout(r, BOOT_MS));
    if (seqOf(section) !== mySeq || section.dataset.open !== 'true') return;
    win.classList.add('is-live');
    canvas?.focus({ preventScroll: true });
  }

  async function close(section: EmbedEl) {
    if (section.dataset.open !== 'true') return;
    section.dataset.open = '';
    const mySeq = bumpSeq(section);
    const { overlay, rig, win, launch } = partsOf(section);

    launch?.setAttribute('aria-expanded', 'false');
    dispatch('bonus:close', { id: section.id });

    const finish = () => {
      if (seqOf(section) !== mySeq) return;
      unmount(section); // also cancels the rig animations
      if (rig) {
        rig.style.removeProperty('transform'); // back to the CSS closed pose
        rig.style.opacity = '0';
      }
      win?.classList.remove('is-live');
      if (overlay) overlay.hidden = true;
      dispatch('bonus:closed', { id: section.id });
      launch?.focus({ preventScroll: true });
    };

    if (!overlay || !rig || !win || reduced()) {
      overlay?.classList.remove('is-open');
      finish();
      return;
    }

    // Palm + screen shrink back down to hand size while the backdrop lifts.
    // Explicit from-keyframe at the CURRENT computed scale, so closing
    // mid-grow shrinks from wherever the grow got to — no snap.
    overlay.classList.remove('is-open');
    const from = rigScale(rig);
    section._growAnim?.cancel();
    section._growAnim = null;
    const small = handScale(rig);
    section._shrinkAnim?.cancel();
    try {
      section._shrinkAnim = rig.animate(
        [
          { transform: `scale(${from})` },
          { transform: `scale(${small})` },
        ],
        { duration: SHRINK_MS, easing: 'cubic-bezier(0.55, 0, 0.68, 1)', fill: 'forwards' },
      );
    } catch {
      section._shrinkAnim = null;
    }
    await settle(section._shrinkAnim, SHRINK_MS);
    finish(); // hands the character back to the site (bonus:closed)
  }

  function toggle(section: EmbedEl) {
    if (section.dataset.open === 'true') close(section);
    else open(section);
  }

  function wire(section: EmbedEl) {
    if (section.dataset.wired === 'true') return;
    section.dataset.wired = 'true';

    if (section.classList.contains('is-bare')) {
      mount(section, section.querySelector<HTMLCanvasElement>('.game-embed-canvas'));
      return;
    }

    // Portal the overlay out of the page's stacking contexts (.project-panel
    // is fixed + z-indexed and would trap it beneath the sidebar).
    const overlay = section.querySelector<HTMLElement>('.game-overlay');
    if (overlay) {
      section._overlay = overlay;
      document.body.appendChild(overlay);
    }

    section.querySelector<HTMLElement>('.game-launch')
      ?.addEventListener('click', () => toggle(section));
    overlay
      ?.querySelector<HTMLElement>('.game-overlay-backdrop')
      ?.addEventListener('click', () => close(section));
    overlay
      ?.querySelector<HTMLElement>('.game-window-close')
      ?.addEventListener('click', () => close(section));
  }

  function wireAll() {
    document.querySelectorAll<EmbedEl>('.game-embed').forEach(wire);
  }

  function teardown() {
    document.querySelectorAll<EmbedEl>('.game-embed').forEach((section) => {
      unmount(section);
      // Remove the body-portaled overlay — the swap only replaces page DOM.
      section._overlay?.remove();
      section._overlay = undefined;
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    document.querySelectorAll<EmbedEl>('.game-embed').forEach(close);
  });

  document.addEventListener('astro:page-load', wireAll);
  document.addEventListener('astro:before-swap', teardown);
  wireAll();
</script>
