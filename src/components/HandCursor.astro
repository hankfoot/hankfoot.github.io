<!-- Hand cursor: ambient scroll-driven hand character, no cursor tracking -->
<div id="hand-cursor" aria-hidden="true"><img src="/ui/hand-raised.svg" alt="" /></div>

<script>
  // ─── Touch gate ───────────────────────────────────────────────
  // On touch devices the hand is display:none (CSS), but until this gate the
  // script still ran: taps on project cards set grab-travel state, and
  // astro:before-preparation DELAYED every navigation waiting for an invisible
  // hand to "arrive". Bail before any state or listeners exist — navigation
  // falls back to Astro's default transitions, and the choreography costs
  // touch users nothing. Also off below 900px: that is where the sidebar the hand
  // points at becomes a top bar, so there is no rail left to travel along.
  // Evaluated once at load — a resize across the breakpoint is handled by the
  // CSS, which hides the element either way, and a hand that never initialised
  // keeps its opacity:0, so nothing stray appears. Mirrors the CSS query exactly.
  const HAND_DISABLED = window.matchMedia(
    '(hover: none), (pointer: coarse), (max-width: 900px)',
  ).matches;

  // Reduced motion is a live toggle (Sidebar), so it can't be an init-time
  // early return — navigation-delaying paths check it at call time instead.
  const reducedMotion = () =>
    document.documentElement.getAttribute('data-reduced-motion') === 'true';

  // Top-level return is illegal in a module script, so the entire body sits
  // inside this guard. Existing indentation left untouched to keep the diff
  // reviewable — this file is deliberately complex.
  if (!HAND_DISABLED) {

  // ─── Hand artwork ─────────────────────────────────────────────
  // Bundled Fluent Emoji SVGs (MIT, microsoft/fluentui-emoji) instead of
  // native glyphs — one hand family on every platform, matching the giant
  // palm in the bonus-level overlay.
  const HAND_SRC = {
    wave:   '/ui/hand-raised.svg',      // ✋ idle wave
    point:  '/ui/hand-point-left.svg',  // 👈 pointing at nav
    travel: '/ui/hand-palm-down.svg',   // 🫳 in transit
    grab:   '/ui/hand-raised-back.svg', // 🤚 braced to receive the panel
    push:   '/ui/hand-push.svg',        // 🫸 shoving the panel away
  } as const;
  // Preload so state swaps never flash an empty frame.
  Object.values(HAND_SRC).forEach(src => { const i = new Image(); i.src = src; });

  function setHand(name: keyof typeof HAND_SRC) {
    const img = el?.querySelector('img');
    if (img && !img.src.endsWith(HAND_SRC[name])) img.src = HAND_SRC[name];
  }

  // ─── Speed constants ──────────────────────────────────────────
  const LERP                  = 0.16;  // ambient movement
  const MAX_PX_PER_FRAME      = 22;    // ambient speed cap
  const GRAB_TRAVEL_LERP      = 0.36;  // snappier lerp for fast travel (grab + flick)
  const GRAB_TRAVEL_MAX_PX    = 50;    // higher speed cap for fast travel
  const GRAB_PULL_PX_PER_FRAME = 14;   // slow pull — gives the panel some mass
  const ARRIVAL_THRESHOLD     = 8;     // px — considered "arrived" within this distance
  // Cross-fade between the homepage and a project drawer. One value for both
  // directions: the page fades out over this as the drawer arrives, and back in
  // over the same as it leaves, so the pair reads as one gesture reversed.
  const PANEL_FADE_MS         = 600;
  // How far the outgoing drawer has to travel before the page starts showing
  // through, as a fraction of its exit. Earlier than this and the fade happens
  // behind a panel that has barely moved; later and it lands after the shove is
  // already over. Expressed as travel, not time, so it stays put if the exit
  // duration or its easing is retuned.
  const PANEL_FADE_AT_TRAVEL  = 0.06;

  // ─── State machine ────────────────────────────────────────────
  // Priority tiers:
  //   1 (highest) — Navigational: grab-travel, grab-pull, flick-travel, flick-push
  //   2           — Easter eggs:  egg-* / in-game (bonus-level dive)
  //   3           — Idle resting: idle (scroll-driven wave/point)
  //   4 (lowest)  — Idle animations: (future) bored-*
  //
  // Higher-priority tiers block lower ones. updateHand() and click handlers
  // guard with `if (state !== 'idle') return` — one check replaces all old flags.
  type HandState =
    | 'idle'           // tier 3: scroll-driven resting
    | 'grab-travel'    // tier 1: fast travel to right edge
    | 'grab-pull'      // tier 1: 🤚 gripping and pulling panel in
    | 'flick-travel'   // tier 1: fast travel to panel's left edge
    | 'flick-push'     // tier 1: 🫸 following panel edge as it slides off-right
    | 'egg-travel'     // tier 2: fast travel to centre screen
    | 'in-game';       // tier 2: hidden — the overlay's giant palm has taken over

  let state: HandState = 'idle';

  // ─── Core variables ───────────────────────────────────────────
  let el = document.getElementById('hand-cursor') as HTMLElement;
  let targetX = 0, targetY = 0;
  let currentX = 0, currentY = 0;
  let rafStarted = false;
  let tickGen = 0;               // incremented on restart; stale loops self-terminate
  let clickLocked: string | null = null; // locks hand to clicked nav section until scroll

  type Mode = 'wave' | 'point';
  let currentMode: Mode = 'wave';  // currently displayed idle mode
  let targetMode:  Mode = 'wave';  // idle mode we're heading toward

  // The panel slide is driven by rAF writing style.transform, NOT by WAAPI.
  //
  // Both a WAAPI transform animation and a CSS opacity transition get promoted
  // to the compositor, and Safari rebuilds accelerated animations when the view
  // transition tears down its layer tree — replaying from the start anything
  // begun inside it. That is what made the panel slide a third of the way, snap
  // back and run again, and the homepage cross-fade fire twice. None of it is
  // visible to script: getComputedStyle keeps reporting a smooth main-thread
  // timeline while the compositor replays underneath, which is why seven runs of
  // frame timing all looked perfect.
  //
  // Waiting for the transition to finish before starting fixed the replay but
  // cost ~290ms of dead time with the drawer frozen part-open. Driving it from
  // rAF on the main thread instead has nothing to rebuild, so it needs no wait.
  // The main thread has the headroom: measured on the machine this was reported
  // from, the whole navigation ran at a flat 60fps with a 17ms median, and an
  // unpromoted box of text sliding the same distance was perfectly smooth.
  let slideGen = 0;          // bumped to abort an in-flight slide
  let panelSlideX = 0;       // current translateX of the drawer, in px
  let panelNaturalLeft = 0;  // its resting left edge, measured before transform
  let handGrabOffsetX = 0;   // how far left of that edge the hand sits
  let handRestY = 0;
  // True only once the drawer exists and its resting edge has been measured.
  // grab-pull begins before the swap, while there is still no .project-panel on
  // the page — without this the hand would be pinned to an unmeasured edge at
  // x=0 and fly to the top-left corner before the drawer ever appeared.
  let panelPinned = false;
  // Resolves when the drawer has landed. Armed at swap time so page-load's
  // release path has something to wait on regardless of how the slide finishes.
  let panelSettled: Promise<void> = Promise.resolve();
  let settlePanel: () => void = () => {};
  let contentClone: HTMLElement | null = null;
  let panelClone:   HTMLElement | null = null;
  let panelScroll = 0;      // scrollTop of the panel at snapshot time (see below)

  /** cubic-bezier solved by Newton-Raphson — matches the CSS curve exactly. */
  function cubicBezier(p1x: number, p1y: number, p2x: number, p2y: number) {
    const cx = 3 * p1x, bx = 3 * (p2x - p1x) - cx, ax = 1 - cx - bx;
    const cy = 3 * p1y, by = 3 * (p2y - p1y) - cy, ay = 1 - cy - by;
    const sampleX = (t: number) => ((ax * t + bx) * t + cx) * t;
    const sampleY = (t: number) => ((ay * t + by) * t + cy) * t;
    const slopeX  = (t: number) => (3 * ax * t + 2 * bx) * t + cx;
    return (x: number) => {
      let t = x;
      for (let i = 0; i < 5; i++) {
        const err = sampleX(t) - x, d = slopeX(t);
        if (Math.abs(err) < 1e-4 || d === 0) break;
        t -= err / d;
      }
      return sampleY(Math.min(Math.max(t, 0), 1));
    };
  }
  const EASE_PANEL = cubicBezier(0.4, 0, 0.2, 1);

  // ─── tick() ───────────────────────────────────────────────────
  function tick(gen: number) {
    if (gen !== tickGen) return; // stale loop — stop

    // In-game the hand is hidden — the overlay's giant palm has taken over.
    if (state === 'in-game') {
      requestAnimationFrame(() => tick(gen));
      return;
    }

    const dx = targetX - currentX;
    const dy = targetY - currentY;
    const dist = Math.sqrt(dx * dx + dy * dy);

    // Fast travel for grab-travel, flick-travel, and egg-travel
    const isFastTravel = state === 'grab-travel' || state === 'flick-travel' || state === 'egg-travel';
    const lerp    = isFastTravel ? GRAB_TRAVEL_LERP : LERP;
    const maxStep = state === 'grab-pull' ? GRAB_PULL_PX_PER_FRAME
                  : isFastTravel          ? GRAB_TRAVEL_MAX_PX
                  :                         MAX_PX_PER_FRAME;
    const step = Math.min(dist * lerp, maxStep);
    if (dist > 0.01) {
      currentX += (dx / dist) * step;
      currentY += (dy / dist) * step;
    }

    if (state === 'grab-pull') {
      // Pinned to the drawer's left edge, computed from the slide's own value
      // rather than measured. Reading the panel's box here used to force a
      // layout every frame — and, once the panel was promoted, forced its
      // compositor animation to sync back to the main thread every frame too.
      if (panelPinned) {
        currentX = panelNaturalLeft + panelSlideX - handGrabOffsetX;
        currentY = handRestY;
        targetX = currentX;
        targetY = currentY;
      }
      el.style.transformOrigin = '50% 50%';
      el.style.transform = `translate(${currentX}px, ${currentY}px) rotate(90deg)`;

    } else if (state === 'flick-push') {
      // Stick directly to the clone's left edge — same pattern as grab-pull
      currentX = targetX;
      currentY = targetY;
      el.style.transformOrigin = '50% 50%';
      el.style.transform = `translate(${currentX}px, ${currentY}px)`;

    } else if (dist > ARRIVAL_THRESHOLD && (state !== 'idle' || currentMode !== targetMode)) {
      // ── GLOBAL TRANSIT ── travel hand for meaningful moves.
      // Fires when navigating (any non-idle state) OR crossing modes (wave↔point).
      // Skipped when idle and already in the right mode — e.g. gliding between
      // nav links stays as 👈 without flashing the travel hand.
      setHand('travel');
      el.style.transformOrigin = '50% 50%';
      const flipX = dx >= 0 ? 1 : -1;
      el.style.transform = `translate(${currentX}px, ${currentY}px) scaleX(${flipX})`;

    } else {
      // At destination — state-specific resting emoji
      if (state === 'idle') {
        if (currentMode !== targetMode) currentMode = targetMode; // snap on arrival
        const rotation = currentMode === 'wave'
          ? Math.sin(performance.now() / 550 * Math.PI) * 10
          : 0;
        setHand(currentMode === 'wave' ? 'wave' : 'point');
        el.style.transformOrigin = '50% 100%';
        el.style.transform = `translate(${currentX}px, ${currentY}px) rotate(${rotation}deg)`;
      }
      // grab-travel: waitForGrabArrival() sets 🤚 on arrival
      // flick-travel: animatePush switches to 🫸 when hand arrives
    }

    requestAnimationFrame(() => tick(gen));
  }

  // ─── Idle resting (tier 3) ────────────────────────────────────
  function waveAtTagline() {
    const heading = document.querySelector<HTMLElement>('.intro-greeting');
    if (!heading) return;
    const range = document.createRange();
    range.selectNodeContents(heading);
    const rect = range.getBoundingClientRect();
    // Don't aim at a tagline that isn't on screen. Clicking the masthead from
    // down the page eases back to the top, and following the hero the whole way
    // would fling the hand hundreds of pixels above the viewport and back. Hold
    // position instead; the scroll re-aims every frame, so the hand picks the
    // tagline up as it arrives and travels only the last short hop.
    if (rect.bottom < 0 || rect.top > window.innerHeight) return;
    const emojiH = el.offsetHeight; // offsetHeight ignores CSS transforms (e.g. rotate from grab-pull)
    targetX = rect.right + 12;
    targetY = rect.top + rect.height / 2 - emojiH * 0.5;
    targetMode = 'wave';
  }

  function pointAtNavLink(section: string) {
    const link = document.querySelector<HTMLElement>(`a[data-section="${section}"]`);
    if (!link) return;
    const range = document.createRange();
    range.selectNodeContents(link);
    const rect = range.getBoundingClientRect();
    const emojiH = el.offsetHeight; // offsetHeight ignores CSS transforms (e.g. rotate from grab-pull)
    targetX = rect.right + 8;
    targetY = rect.top + rect.height / 2 - emojiH / 2;
    targetMode = 'point';
  }

  const SECTIONS = [
    { key: 'intro',    selector: '.page-intro', action: () => waveAtTagline() },
    { key: 'projects', selector: '#projects',   action: () => pointAtNavLink('projects') },
    { key: 'about',    selector: '#about',      action: () => pointAtNavLink('about') },
    { key: 'cv',       selector: '#cv',         action: () => pointAtNavLink('cv') },
    { key: 'contact',  selector: '#contact',    action: () => pointAtNavLink('contact') },
  ];

  function updateHand() {
    if (state !== 'idle') return; // tier 1/2 takes priority — single clean guard
    if (clickLocked) return;

    // Project pages have none of the homepage sections — keep the hand on "projects"
    if (window.location.pathname.startsWith('/projects/')) { pointAtNavLink('projects'); return; }

    const atBottom = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 80;
    if (atBottom) { pointAtNavLink('contact'); return; }

    // The hero owns the hand while it's meaningfully on screen — the wave next
    // to the name is the page's opening beat and has to survive load. The
    // midpoint scan below can't do that job: the hero is shorter than half a
    // viewport, so at scroll 0 the project grid's top is already above the
    // midpoint and the scan hands straight off to 'projects'.
    // Measured against the hero's own height, not a fixed slice of the viewport:
    // the hero is free to get shorter (the tagline dropped to the SUBTITLE role
    // and lost its authored line break), and a hardcoded threshold silently
    // stops matching when it does. Half of whichever is smaller — the hero or
    // the viewport — so a hero taller than the window still qualifies at rest.
    const intro = document.querySelector('.page-intro');
    if (intro) {
      const introRect = intro.getBoundingClientRect();
      const visible = Math.min(introRect.bottom, window.innerHeight) - Math.max(introRect.top, 0);
      const needed = Math.min(introRect.height, window.innerHeight) * 0.5;
      if (visible > needed) { waveAtTagline(); return; }
    }

    const scrollMid = window.scrollY + window.innerHeight * 0.5;
    let best: typeof SECTIONS[number] | null = null;
    for (const s of SECTIONS) {
      const node = document.querySelector(s.selector);
      if (!node) continue;
      const docTop = node.getBoundingClientRect().top + window.scrollY;
      if (docTop <= scrollMid) best = s;
    }
    if (best) best.action();
  }

  // ─── Navigational (tier 1) ────────────────────────────────────

  // Kick off grab: fly to the right edge to meet the incoming panel
  function moveToGrabPosition() {
    if (state !== 'idle') return; // don't interrupt an active nav
    // Reduced motion: the hand is CSS-hidden, so grab-travel would silently
    // delay navigation (the loader awaits arrival). Skip the choreography.
    if (reducedMotion()) return;
    state = 'grab-travel';
    clickLocked = null;
    el.style.opacity = '1';
    const emojiRect = el.getBoundingClientRect();
    targetX = window.innerWidth - emojiRect.width - 24;
    targetY = window.innerHeight / 2 - emojiRect.height / 2;
  }

  // Resolves when hand arrives at the right edge.
  // Runs concurrently with the page fetch — Astro waits for both.
  function waitForGrabArrival(): Promise<void> {
    return new Promise(resolve => {
      function check() {
        if (state !== 'grab-travel') { resolve(); return; } // aborted
        const dx = targetX - currentX;
        const dy = targetY - currentY;
        if (Math.sqrt(dx * dx + dy * dy) < ARRIVAL_THRESHOLD) {
          state = 'grab-pull';
          setHand('grab'); // raised back of hand — braced to receive the panel
          // Snapshot the content area — will fade out during the panel slide-in
          const contentArea = document.querySelector<HTMLElement>('.content-area');
          if (contentArea) {
            const rect = contentArea.getBoundingClientRect();
            contentClone = contentArea.cloneNode(true) as HTMLElement;
            Object.assign(contentClone.style, {
              position: 'fixed',
              top: `${rect.top}px`,
              left: `${rect.left}px`,
              width: `${rect.width}px`,
              // Clip to what is actually on screen. Without a height the clone
              // is as tall as the whole scrollable homepage — measured at 3093px
              // against an 860px viewport — and the browser rasterises all of it
              // to composite the fade below. That is 3.3M pixels of texture to
              // animate where 0.9M is visible; the rest is paid for and never
              // seen. The clone is position:fixed at the old scroll offset, so
              // nothing below the fold could have shown anyway.
              height: `${Math.max(0, window.innerHeight - rect.top)}px`,
              overflow: 'hidden',
              pointerEvents: 'none',
              zIndex: '10',
              // Promote now, while we are already off the critical path. Left to
              // the transition below, the layer gets built on the first frame of
              // the fade — a hitch exactly where the animation starts.
              willChange: 'opacity',
            });
            // Carry the decoded images over to the clone.
            //
            // This used to ask the CLONE whether it had decoded — but a freshly
            // cloned <img> starts its load again from scratch, so `complete` is
            // false at that instant even for an image sitting in cache, fully
            // painted, one frame ago. Every image therefore got hidden, and the
            // card's placeholder tint showed through: at the moment of
            // navigation the homepage visibly dropped every photo to a grey box,
            // then the panel slid over the wreckage. The guard meant to prevent
            // a flash of placeholder boxes was producing one.
            //
            // Ask the ORIGINAL instead, and pin the clone to the exact URL the
            // original already resolved — dropping srcset/sizes so the browser
            // cannot re-run selection and pick a different file it would have to
            // fetch. Only genuinely unloaded images get hidden now.
            // Repainting the clone's images from the ORIGINAL's decoded pixels.
            //
            // Two earlier attempts both flashed. Asking the clone whether it had
            // decoded hid everything, because a cloned <img> restarts its load
            // and reports complete=false even for a cached image — the homepage
            // dropped every photo to its placeholder tint. Pointing the clone at
            // the already-resolved URL cut that to a single frame, but only one:
            // assigning src restarts the load no matter what, and Safari needs a
            // frame to decode even a cache hit. Measured at exactly one frame of
            // full desaturation, which still reads as a flicker.
            //
            // So don't go through the network stack at all. drawImage() from a
            // loaded <img> is synchronous and copies the bitmap the compositor
            // already has, so the clone is correct on the very first frame.
            const liveImgs = contentArea.querySelectorAll<HTMLImageElement>('img');
            contentClone.querySelectorAll<HTMLImageElement>('img').forEach((img, i) => {
              const live = liveImgs[i];
              const box = live?.getBoundingClientRect();
              // Only what is actually on screen and actually decoded is worth
              // copying; anything else is hidden, exactly as before.
              if (!live || !live.complete || !live.naturalWidth || !box
                  || box.width < 1 || box.bottom < 0 || box.top > window.innerHeight) {
                img.style.visibility = 'hidden';
                return;
              }
              try {
                const dpr = Math.min(window.devicePixelRatio || 1, 2);
                const canvas = document.createElement('canvas');
                canvas.width = Math.round(box.width * dpr);
                canvas.height = Math.round(box.height * dpr);
                canvas.style.width = `${box.width}px`;
                canvas.style.height = `${box.height}px`;
                canvas.style.display = 'block';
                const ctx = canvas.getContext('2d')!;
                // Reproduce object-fit: cover / contain by hand — a canvas has no
                // object-fit, so the crop has to be baked into the draw.
                const fit = getComputedStyle(live).objectFit;
                const sx = canvas.width / live.naturalWidth;
                const sy = canvas.height / live.naturalHeight;
                const scale = fit === 'contain' ? Math.min(sx, sy)
                            : fit === 'fill'    ? 0 // handled below
                            :                     Math.max(sx, sy);
                if (scale === 0) {
                  ctx.drawImage(live, 0, 0, canvas.width, canvas.height);
                } else {
                  const w = live.naturalWidth * scale;
                  const h = live.naturalHeight * scale;
                  ctx.drawImage(live, (canvas.width - w) / 2, (canvas.height - h) / 2, w, h);
                }
                img.replaceWith(canvas);
              } catch {
                // Anything unexpected (a tainted canvas, a zero-size draw) falls
                // back to the old behaviour rather than breaking the transition.
                img.style.visibility = 'hidden';
              }
            });
          }
          resolve();
        } else {
          requestAnimationFrame(check);
        }
      }
      requestAnimationFrame(check);
    });
  }

  // ─── Clone cleanup ────────────────────────────────────────────
  function cleanupContentClone() {
    contentClone?.remove();
    contentClone = null;
  }

  function cleanupPanelClone() {
    panelClone?.remove();
    panelClone = null;
  }

  // ─── Tier 2: bonus-level easter egg ───────────────────────────
  // Choreography with GameCanvas's palm overlay, coordinated via bonus:*
  // document events (see GameCanvas.astro for the host's side):
  //   open   → fly to centre screen (egg-travel); on arrival, hide and
  //            dispatch hand-ready — the overlay's giant palm takes over
  //            and grows with the game window in its centre
  //   close  → stand by (the host shrinks the palm back down)
  //   closed → reappear at centre screen, hand-sized, and return to idle
  //   (closed mid-travel: bonus:close aborts straight back to idle)

  let eggSectionId: string | null = null;

  function resetEgg() {
    eggSectionId = null;
  }

  function waitEggArrival() {
    function check() {
      if (state !== 'egg-travel') return;
      const dx = targetX - currentX;
      const dy = targetY - currentY;
      if (Math.sqrt(dx * dx + dy * dy) < ARRIVAL_THRESHOLD) {
        // Hand off to the overlay's palm — same spot, same size.
        state = 'in-game';
        el.style.opacity = '0';
        document.dispatchEvent(new CustomEvent('bonus:hand-ready', {
          detail: { id: eggSectionId },
        }));
      } else {
        requestAnimationFrame(check);
      }
    }
    requestAnimationFrame(check);
  }

  document.addEventListener('bonus:open', (e: Event) => {
    if (state !== 'idle') return; // nav takes priority; the host has timeouts
    if (document.documentElement.getAttribute('data-reduced-motion') === 'true') return;
    eggSectionId = (e as CustomEvent).detail?.id ?? null;
    state = 'egg-travel';
    clickLocked = null;
    // Centre screen — where the palm will grow.
    targetX = window.innerWidth / 2 - el.offsetWidth / 2;
    targetY = window.innerHeight / 2 - el.offsetHeight / 2;
    waitEggArrival();
  });

  document.addEventListener('bonus:close', (e: Event) => {
    const id = (e as CustomEvent).detail?.id;
    if (id !== eggSectionId) return;
    if (state === 'egg-travel') {
      // Closed before the hand even arrived — just go home.
      resetEgg();
      state = 'idle';
      updateHand();
    }
    // in-game: stand by — bonus:closed brings the hand back.
  });

  document.addEventListener('bonus:closed', (e: Event) => {
    const id = (e as CustomEvent).detail?.id;
    if (id !== eggSectionId) return;
    const wasInGame = state === 'in-game';
    resetEgg();
    if (!wasInGame) return;
    // The palm shrank back to hand size at centre screen — pick up from there.
    currentX = window.innerWidth / 2 - el.offsetWidth / 2;
    currentY = window.innerHeight / 2 - el.offsetHeight / 2;
    targetX = currentX;
    targetY = currentY;
    el.style.transform = `translate(${currentX}px, ${currentY}px)`;
    el.style.opacity = '1';
    state = 'idle';
    updateHand();
  });

  // Tier 4: Idle boredom — only fires when nothing else (tiers 1–3) is active
  const IDLE_BOREDOM_MS = 12000;
  let idleTimer: ReturnType<typeof setTimeout> | null = null;
  function resetIdleTimer() {
    if (idleTimer) clearTimeout(idleTimer);
    if (state !== 'idle') return;
    idleTimer = setTimeout(() => {
      if (state === 'idle') { /* triggerBoredAnimation() */ }
    }, IDLE_BOREDOM_MS);
  }

  // ─── Astro lifecycle ──────────────────────────────────────────

  // Panel transitions are not interruptible. While one is in flight the
  // choreography owns the screen, so swallow clicks that would navigate this
  // document rather than trying to unwind a half-played animation — every
  // graceful-interruption path we had still left something visible, whether a
  // stale snapshot fading over a scrolled page or a half-shoved panel vanishing.
  //
  // Capture phase, so this lands before the card and nav handlers below and they
  // never see the click at all. Links that go somewhere else are untouched: a new
  // tab, a download, mailto, or another origin does not disturb the animation, and
  // silently eating those would just look broken.
  const PANEL_TRANSITIONS = ['grab-travel', 'grab-pull', 'flick-travel', 'flick-push'];
  document.addEventListener('click', (e) => {
    if (!PANEL_TRANSITIONS.includes(state)) return;
    const link = (e.target as Element)?.closest?.('a[href]') as HTMLAnchorElement | null;
    if (!link) return;
    if (link.target === '_blank' || link.hasAttribute('download')) return;
    // Modified clicks open a new tab, so they leave this document alone.
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    let url: URL;
    try { url = new URL(link.href, location.href); } catch { return; }
    if (url.origin !== location.origin) return; // off-site, or mailto: (origin "null")
    e.preventDefault();
    e.stopPropagation();
  }, { capture: true });


  // Intercept the navigation loader so the page waits for the hand animation (grab only)
  document.addEventListener('astro:before-preparation', (e: Event) => {
    cleanupContentClone();
    cleanupPanelClone();

    // Clicking anything mid-shove used to wedge the whole hand system. The push
    // loop bails on the clone nulled just above without reaching the line that
    // clears the state, and page-load deliberately skips flick states on the
    // assumption that loop is still running — so nothing reset it. Every entry
    // point is guarded on `state === 'idle'`, so one interrupted back-click left
    // the hand frozen, project cards no longer pulling the panel in, and the nav
    // choreography dead for the rest of the session. Reset before the branches
    // below read state, so the new navigation starts from a known footing.
    if (state === 'flick-travel' || state === 'flick-push') state = 'idle';

    // That same loop may have left the outgoing page part-way through its fade.
    // The element is swapped eventually, but not until the fetch resolves, and
    // until then a half-faded or fully transparent page stays on screen.
    const outgoing = document.querySelector<HTMLElement>('.content-area');
    if (outgoing) {
      outgoing.style.removeProperty('transition');
      outgoing.style.removeProperty('opacity');
    }

    // Abort any bonus-level sequence — navigation outranks easter eggs.
    if (state.startsWith('egg-') || state === 'in-game') {
      resetEgg();
      el.style.opacity = '1';
      state = 'idle';
    }
    const event = e as any;
    const originalLoader = event.loader.bind(event);

    // Where this navigation is actually headed. The grab choreography commits to
    // a panel arriving and never rechecks, so clicking "projects" while a project
    // page is still opening used to keep the grab alive: it delayed the second
    // navigation too, then snapshotted the page for a cross-fade against a panel
    // that does not exist on the home page. The snapshot is taken at the old
    // scroll offset and faded over a page the browser has since scrolled, which
    // is what read as a jump. Abandon the grab instead when the destination is no
    // longer a project.
    const toProject = String(event.to?.pathname ?? '').startsWith('/projects/');
    if ((state === 'grab-travel' || state === 'grab-pull') && !toProject) {
      slideGen++;
      panelPinned = false;
      cleanupContentClone();
      state = 'idle';
    }

    if (state === 'grab-travel') {
      // Outgoing grab: wait for hand to reach the right edge before swapping
      event.loader = () => Promise.all([originalLoader(), waitForGrabArrival()]);

    } else if (window.location.pathname.startsWith('/projects/') && state !== 'grab-pull'
               && !reducedMotion()) {
      // Leaving a project page: snapshot the panel now (before DOM swap),
      // then fly the hand to its left edge. Navigation is NOT delayed.
      const panel = document.querySelector<HTMLElement>('.project-panel');
      if (panel) {
        const snapRect = panel.getBoundingClientRect();
        // .project-panel is the scroll container on project pages, and
        // cloneNode copies markup but not scrollTop — that is runtime state,
        // not an attribute. Without carrying it over the clone renders from the
        // top of the article, so leaving a scrolled page looked like the content
        // snapped to the top just before it flew off. Re-applied after the clone
        // is in the document; setting it beforehand has nothing to scroll.
        panelScroll = panel.scrollTop;
        panelClone = panel.cloneNode(true) as HTMLElement;
        Object.assign(panelClone.style, {
          position: 'fixed',
          top: `${snapRect.top}px`,
          left: `${snapRect.left}px`,
          width: `${snapRect.width}px`,
          height: `${snapRect.height}px`,
          overflow: 'hidden',
          pointerEvents: 'none',
          zIndex: '100',
          margin: '0',
          transform: 'none',
        });
        // Fly hand to the panel's left edge (grab-travel speed)
        const emojiRect = el.getBoundingClientRect();
        targetX = snapRect.left - emojiRect.width * 0.8;
        targetY = window.innerHeight * 0.5 - emojiRect.height * 0.5;
        state = 'flick-travel';
        clickLocked = null;
      }
    }
  });

  // Hand has arrived and page is about to swap in — keep 🤚
  document.addEventListener('astro:before-swap', () => {
    if (state !== 'grab-pull') return;
    setHand('grab');
  });

  // Re-query el after DOM swap; kick off panel animation and clone effects
  document.addEventListener('astro:after-swap', () => {
    el = document.getElementById('hand-cursor') as HTMLElement;

    // Fade out the homepage snapshot simultaneously with the panel slide-in
    if (contentClone) {
      // Appended here, but faded by the slide loop below rather than by a CSS
      // transition — opacity is compositor-accelerated too, so a transition
      // started here gets replayed by Safari exactly like the slide did, which
      // is what made the homepage appear to fade out twice.
      document.body.appendChild(contentClone);
    }

    // Panel slide-in. Gated here in script because reduced motion has to be
    // honoured and CSS cannot see this animation at all.
    const panel = document.querySelector<HTMLElement>('.project-panel');
    if (panel && !reducedMotion()) {
      const duration = state === 'grab-pull' ? 950 : 220;
      const wasGrabPull = state === 'grab-pull';
      const handRect = el.getBoundingClientRect();

      // Measured BEFORE any transform is applied, so it is the resting position.
      // Reading it afterwards returns the offscreen one, because
      // getBoundingClientRect includes transforms — which silently made the
      // hand's destination its own start point, so it sat still for the whole
      // slide and only moved when the nav-link handoff yanked it left at the end.
      panelNaturalLeft = panel.getBoundingClientRect().left;
      handGrabOffsetX = handRect.width * 0.4;
      handRestY = window.innerHeight * 0.5 - handRect.height * 0.5;

      const fromX = wasGrabPull
        ? currentX + handGrabOffsetX - panelNaturalLeft
        : panel.getBoundingClientRect().width;

      panelSettled = new Promise<void>(res => { settlePanel = res; });
      // Safety net: release the hand even if the slide never reports back,
      // rather than leaving it wedged in grab-pull for the rest of the session.
      setTimeout(() => settlePanel(), duration + 600);
      panelPinned = true;
      const gen = ++slideGen;
      panelSlideX = fromX;
      panel.style.transform = `translateX(${fromX}px)`;

      const startedAt = performance.now();
      const slide = (now: number) => {
        if (gen !== slideGen) return;           // a new navigation took over
        const t = Math.min((now - startedAt) / duration, 1);
        panelSlideX = fromX * (1 - EASE_PANEL(t));
        panel.style.transform = `translateX(${panelSlideX}px)`;

        // The homepage uncovers on the same clock, so the two read as one move.
        if (contentClone) {
          const f = Math.min((now - startedAt) / PANEL_FADE_MS, 1);
          contentClone.style.opacity = String(1 - f);
          if (f >= 1) cleanupContentClone();
        }

        if (t < 1) { requestAnimationFrame(slide); return; }
        panelSlideX = 0;
        panel.style.transform = 'translateX(0)';
        settlePanel();
      };
      requestAnimationFrame(slide);

      // Hold video playback until the drawer has landed. Four clips spinning up
      // their decoders is the single biggest thing competing with this animation.
      document.dispatchEvent(new CustomEvent('panel:animating', { detail: { duration } }));
    }

    // Ensure re-queried el has the right emoji for the current state
    if (state === 'grab-pull') {
      el.style.opacity = '1';
      setHand('grab');
    } else if (state === 'grab-travel') {
      el.style.opacity = '1';
    }

    // Push exit: inject panelClone and drive it off-right with a manual rAF loop.
    // targetX tracks the clone's left edge each frame so the hand follows it.
    if (panelClone) {
      el.style.opacity = '1';
      document.body.appendChild(panelClone);
      // overflow is hidden on the clone, which still scrolls programmatically —
      // this is what keeps the frame you were actually looking at.
      panelClone.scrollTop = panelScroll;

      // Fade the homepage back in, mirroring the fade-out that hides it when the
      // drawer arrives. Driven per frame from the clone's position below, not by
      // a timed transition: the exit eases IN, so the panel sits over the page
      // for most of its flight and only sweeps clear at the end. Any
      // duration-based fade therefore completes underneath the panel — it was
      // measurably running and still invisible. Tying opacity to how much of the
      // page is uncovered puts the fade on the part you can actually see.
      const incomingContent = document.querySelector<HTMLElement>('.content-area');
      if (incomingContent) incomingContent.style.opacity = '0';

      const cloneStartLeft = parseFloat(panelClone.style.left);
      const exitDistance   = window.innerWidth - cloneStartLeft; // move left edge to right of viewport
      const duration = 900; // ms — ease-in so hand can catch up before acceleration
      const startTime = performance.now();
      const emojiW = el.getBoundingClientRect().width;
      let fadeStarted = false; // set the frame the hand lands on the panel

      function animatePush(now: number) {
        if (!panelClone) return; // aborted (new nav started)

        const t = Math.min((now - startTime) / duration, 1);
        // Ease-in cubic: starts slow so the hand catches up, then accelerates
        const eased = t * t * t;
        const cloneLeft = cloneStartLeft + exitDistance * eased;

        panelClone.style.left = `${cloneLeft}px`;

        // Hand follows the clone's left edge
        targetX = cloneLeft - emojiW * 0.8;

        // Switch to push emoji once hand has arrived near the panel edge.
        // Checked before the fade below, so arrival and the first frame of the
        // fade land together rather than a frame apart.
        if (state === 'flick-travel') {
          const dxHand = targetX - currentX;
          const dyHand = targetY - currentY;
          if (Math.sqrt(dxHand * dxHand + dyHand * dyHand) < ARRIVAL_THRESHOLD * 4) {
            state = 'flick-push';
            setHand('push');
          }
        }

        // Held at 0 until the clone is PANEL_FADE_AT_TRAVEL of the way off, then
        // a single PANEL_FADE_MS transition. Starting any earlier — on the
        // hand's contact, or metered against the eased travel — put the fade
        // behind a panel that had barely moved, so it either finished unseen or
        // crawled. The threshold is comfortably after contact, so the hand has
        // always landed and shoved before the page begins to show.
        if (incomingContent && !fadeStarted && eased >= PANEL_FADE_AT_TRAVEL) {
          fadeStarted = true;
          incomingContent.style.transition = `opacity ${PANEL_FADE_MS}ms ease`;
          incomingContent.style.opacity = '1';
          // Cleared on its own completion, not with the clone: starting this
          // late means the fade outlives the shove, and tearing the inline
          // styles off at the end of the exit would snap it to full mid-way.
          incomingContent.addEventListener('transitionend', () => {
            incomingContent.style.removeProperty('transition');
            incomingContent.style.removeProperty('opacity');
          }, { once: true });
        }

        if (t < 1) {
          requestAnimationFrame(animatePush);
        } else {
          // The fade clears itself on transitionend — see above. If the shove
          // ended before it ever started (aborted nav), make sure the page is
          // not left invisible.
          if (incomingContent && !fadeStarted) {
            incomingContent.style.removeProperty('transition');
            incomingContent.style.removeProperty('opacity');
          }
          cleanupPanelClone();
          state = 'idle';
          updateHand();
        }
      }
      requestAnimationFrame(animatePush);
    }
  });

  document.addEventListener('astro:page-load', () => {
    const prevState = state;

    // Re-query after transition:persist may have moved/replaced the DOM node
    el = document.getElementById('hand-cursor') as HTMLElement;
    el.style.opacity = '1';

    // Restart tick loop (old loop self-terminates via tickGen)
    tickGen++;
    requestAnimationFrame(() => tick(tickGen));

    resetIdleTimer();

    if (prevState === 'grab-pull') {
      // Keep grab-pull alive until the panel animation fully completes
      const release = () => {
        state = 'idle';
        panelPinned = false;
        currentMode = 'point';
        cleanupContentClone();
        document.querySelector<HTMLElement>('.project-panel')?.style.removeProperty('transform');
        if (window.location.pathname.startsWith('/projects/')) pointAtNavLink('projects');
        else updateHand();
      };
      panelSettled
        .then(() => setTimeout(release, 180))
        .catch(release);

    } else if (prevState === 'flick-travel' || prevState === 'flick-push') {
      // Uninterrupted, animatePush is still running and clears the state when it
      // finishes. An interrupted one is already back to idle — before-preparation
      // resets it, because that loop dies without ever reaching its own reset.

    } else {
      state = 'idle';
      cleanupContentClone();
      updateHand();
    }

    // Re-attach click listeners after each page load

    // Nav links: lock hand to clicked section until scroll (only when idle)
    document.querySelectorAll<HTMLElement>('a[data-section]').forEach(link => {
      link.addEventListener('click', () => {
        if (state !== 'idle') return;
        const section = link.dataset.section!;
        clickLocked = section;
        if (section === 'intro') waveAtTagline();
        else pointAtNavLink(section);
      });
    });

    // Project cards: begin grab travel
    document.querySelectorAll<HTMLElement>('.project-card').forEach(card => {
      card.addEventListener('click', moveToGrabPosition);
    });
  });

  // Sidebar badge (persisted, re-rendered) asks for the grab-pull entrance —
  // same choreography as clicking a project card, dispatched synchronously
  // before Astro's router starts the navigation.
  document.addEventListener('hand:grab', moveToGrabPosition);

  // A nav click locks the hand to that link, and the lock is meant to survive
  // until the *user* scrolls. Smooth anchor scrolling made that unreliable: the
  // eased scroll fires dozens of events, the first of which released the lock
  // and handed control to the midpoint scan mid-flight, so the hand twitched
  // after each section as it went past. Hold the lock while the scroll is still
  // moving and release it once it settles — the next real scroll drives the
  // hand exactly as before.
  let scrollSettle: number | undefined;
  window.addEventListener('scroll', () => {
    resetIdleTimer();
    if (clickLocked) {
      // Re-aim at the locked section rather than running the midpoint scan. The
      // scan is what caused the chasing; the section's own action is safe to
      // repeat. It also has to repeat: pointAtNavLink targets the sticky
      // sidebar, so recomputing is a no-op, but waveAtTagline targets the hero,
      // which is still travelling into view during an eased scroll. Aiming once
      // at click time would send the hand to wherever the tagline was then —
      // far above the viewport when the click came from further down the page.
      if (state === 'idle') SECTIONS.find(sec => sec.key === clickLocked)?.action();
      clearTimeout(scrollSettle);
      scrollSettle = window.setTimeout(() => { clickLocked = null; }, 140);
      return;
    }
    updateHand();
  }, { passive: true });
  window.addEventListener('resize', () => { clickLocked = null; updateHand(); }, { passive: true });

  // Initial tick on first load (before astro:page-load fires)
  if (!rafStarted) {
    rafStarted = true;
    tickGen++;
    requestAnimationFrame(() => tick(tickGen));
  }

  } // end !HAND_DISABLED gate
</script>
