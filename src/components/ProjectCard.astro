---
import SmartImage from './SmartImage.astro';

interface Props {
  title: string;
  timeline: string;
  tags: string[];
  thumb: string;
  summary: string;
  href: string;
}

const { title, timeline, tags, thumb, summary, href } = Astro.props;
---
<a href={href} class="project-card">
  <div class="project-card-thumb">
    {thumb && (
      <SmartImage src={thumb} alt={title} widths={[400, 640, 1000]} sizes="(max-width: 600px) 100vw, 50vw" />
    )}
  </div>
  <h2 class="project-card-title">{title}</h2>
  <p class="project-card-summary">{summary}</p>
  <p class="project-card-meta">{timeline}</p>
  <ul class="tags">
    {tags.map(tag => <li class="tag">{tag}</li>)}
  </ul>
</a>
