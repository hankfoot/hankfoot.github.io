---
type OutcomeItem = string | { text: string; url: string };

interface Props {
  title: string;
  summary?: string;
  timeline: string;
  tags: string[];
  context?: string;
  contextLabel?: string;
  contextUrl?: string;
  role?: string[];
  tools?: string[];
  outcomes?: OutcomeItem[];
  thumb?: string;
}

import { parseInline } from '../utils/text';

const { title, summary, timeline, tags, context, contextLabel, contextUrl, role, tools, outcomes } = Astro.props;
---

<article class="project-panel">
  <a href="/" class="project-panel-back">← back</a>

  <div class="pp-sections">

  <header class="ph-header">
    <h1 class="ph-title">{title}</h1>

    {summary && <p class="ph-hook">{summary}</p>}

    <div class="ph-meta">

      {context && (
        <div class="ph-meta-field">
          <span class="ph-meta-label">{contextLabel ?? 'Client'}</span>
          <ul class="ph-meta-list">
            <li class="ph-meta-value" set:html={contextUrl ? `<a href="${contextUrl}" target="_blank" rel="noopener noreferrer">${context}</a>` : parseInline(context)} />
          </ul>
        </div>
      )}

      <div class="ph-meta-field">
        <span class="ph-meta-label">Timeline</span>
        <ul class="ph-meta-list">
          <li class="ph-meta-value">{timeline}</li>
        </ul>
      </div>

      {role && role.length > 0 && (
        <div class="ph-meta-field">
          <span class="ph-meta-label">Role</span>
          <ul class="ph-meta-list">
            {role.map(c => <li class="ph-meta-value">{c}</li>)}
          </ul>
        </div>
      )}

      {tools && tools.length > 0 && (
        <div class="ph-meta-field">
          <span class="ph-meta-label">Tools</span>
          <ul class="ph-meta-list">
            {tools.map(t => <li class="ph-meta-value">{t}</li>)}
          </ul>
        </div>
      )}

      {outcomes && outcomes.length > 0 && (
        <div class="ph-meta-field">
          <span class="ph-meta-label">Outcomes</span>
          <ul class="ph-meta-list">
            {outcomes.map(o => (
              <li
                class="ph-meta-value"
                set:html={typeof o === 'string'
                  ? parseInline(o)
                  : `<a href="${o.url}" target="_blank" rel="noopener noreferrer">${o.text}</a>`}
              />
            ))}
          </ul>
        </div>
      )}

    </div>

  </header>

  <div class="project-panel-body">
    <slot />
  </div>

  </div><!-- /.pp-sections -->
</article>
