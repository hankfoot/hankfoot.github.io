<button
  class="motion-toggle"
  id="motion-toggle"
  aria-label="Toggle reduced motion"
  data-on="false"
>
  <span class="motion-icon">✕</span>
  <span class="motion-toggle-track"></span>
  <span class="motion-emoji"><img src="/ui/hand-wave.svg" alt="" /></span>
</button>

<script>
  import { getBadges, clearBadges, BADGE_EVENT, BADGE_RESET } from '../utils/badges.ts';
  import { emojiSvgUrl } from '../games/emoji';

  function esc(s) {
    return String(s).replace(/[&<>"]/g, c =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  }

  function renderBadges() {
    const wrap = document.getElementById('sidebar-badges');
    const rack = document.getElementById('sidebar-badges-rack');
    if (!wrap || !rack) return;

    const badges = getBadges();
    wrap.hidden = badges.length === 0;

    rack.innerHTML = badges
      .map(b => {
        const justEarned = b.id === rack.dataset.flash ? ' is-new' : '';
        const aria = b.source ? `${b.label}, earned at ${b.source}` : b.label;
        const src = b.source
          ? `<span class="sidebar-badge-tip-src">from ${esc(b.source)}</span>`
          : '';
        // prefer the bundled SVG sprite over the platform emoji glyph
        const svg = emojiSvgUrl(b.icon);
        const iconHtml = svg
          ? `<img class="sidebar-badge-svg" src="${esc(svg)}" alt="" />`
          : b.icon;
        const inner = `${iconHtml}<span class="sidebar-badge-tip" aria-hidden="true"><span class="sidebar-badge-tip-label">${esc(b.label.toLowerCase())}</span>${src}</span>`;
        // Link back to the minigame when we know where it came from; else a static chip.
        return b.href
          ? `<a class="sidebar-badge${justEarned}" href="${esc(b.href)}" aria-label="${esc(aria)}, revisit">${inner}</a>`
          : `<span class="sidebar-badge${justEarned}" tabindex="0" role="img" aria-label="${esc(aria)}">${inner}</span>`;
      })
      .join('');
  }

  function initReset() {
    const btn = document.getElementById('sidebar-badges-reset');
    if (!btn || btn.dataset.ready === 'true') return;
    btn.dataset.ready = 'true';
    btn.addEventListener('click', () => clearBadges());
  }

  // Delegated on the rack (survives re-renders — only its children change).
  // A badge links back to the project page that awarded it. Clicking it while
  // already on that page shouldn't re-navigate (which would push the panel out
  // and back); just scroll the panel to the top. From the home page or a
  // different project page, let Astro navigate — the panel slides in from the
  // right via the HandCursor choreography.
  function initBadgeNav() {
    const rack = document.getElementById('sidebar-badges-rack');
    if (!rack || rack.dataset.navReady === 'true') return;
    rack.dataset.navReady = 'true';
    rack.addEventListener('click', (e) => {
      const link = (e.target as Element)?.closest?.('a.sidebar-badge') as HTMLAnchorElement | null;
      if (!link) return;
      const href = link.getAttribute('href');
      if (!href) return;
      if (new URL(href, location.href).pathname !== location.pathname) {
        // Different page (home or another project): let Astro navigate, but first
        // kick off the hand's grab-pull choreography — same as clicking a project
        // card — so the panel is pulled in from the right (rather than a fast
        // fade, or the current project being shoved out of the way).
        document.dispatchEvent(new CustomEvent('hand:grab'));
        return;
      }

      e.preventDefault();
      // On a project page the scroll container is the fixed .project-panel, not the window.
      const scroller = document.querySelector<HTMLElement>('.project-panel')
        ?? document.scrollingElement
        ?? document.documentElement;
      const reduced = document.documentElement.getAttribute('data-reduced-motion') === 'true';
      scroller.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
    });
  }

  // Briefly flag the freshly-earned badge so it can play an entrance animation.
  window.addEventListener(BADGE_EVENT, (e) => {
    const rack = document.getElementById('sidebar-badges-rack');
    if (rack && e.detail?.id) rack.dataset.flash = e.detail.id;
    renderBadges();
  });

  window.addEventListener(BADGE_RESET, () => {
    const rack = document.getElementById('sidebar-badges-rack');
    if (rack) rack.dataset.flash = '';
    renderBadges();
  });

  document.addEventListener('astro:page-load', () => { renderBadges(); initReset(); initBadgeNav(); });
  renderBadges();
  initReset();
  initBadgeNav();

  function initToggle() {
    const btn = document.getElementById('motion-toggle') as HTMLButtonElement | null;
    if (!btn) return;

    function getReduced(): boolean {
      return document.documentElement.getAttribute('data-reduced-motion') === 'true';
    }

    function sync() {
      btn!.setAttribute('data-on', String(!getReduced()));
    }

    btn.addEventListener('click', () => {
      const next = !getReduced();
      document.documentElement.setAttribute('data-reduced-motion', String(next));
      localStorage.setItem('hank-reduced-motion', String(next));
      sync();
    });

    sync();
  }

  // Run on initial load and after each page transition
  document.addEventListener('astro:page-load', initToggle);
  initToggle();
</script>
