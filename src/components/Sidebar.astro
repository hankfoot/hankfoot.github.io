<aside class="sidebar">
  <div class="sidebar-top">
    <p class="sidebar-name">hank duhaime <span class="sidebar-hand">👋</span></p>
    <p class="sidebar-bio">
      interaction designer<br />
      + <code class="intro-code">creative technologist</code>
    </p>
  </div>

  <nav class="sidebar-nav">
    <a href="/#projects" data-section="projects">projects</a>
    <a href="/#about" data-section="about">about</a>
    <a href="/#cv" data-section="cv">cv</a>
    <a href="/#contact" data-section="contact">contact</a>
  </nav>

  <div class="sidebar-badges" id="sidebar-badges" hidden>
    <div class="sidebar-badges-head">
      <p class="sidebar-badges-label">badges</p>
      <button type="button" class="sidebar-badges-reset" id="sidebar-badges-reset" aria-label="Reset earned badges">reset</button>
    </div>
    <div class="sidebar-badges-rack" id="sidebar-badges-rack"></div>
  </div>

  <footer class="sidebar-footer">
    <p class="sidebar-location">seattle, wa</p>
    <a href="mailto:hello.hank.d@gmail.com" class="sidebar-email">hello.hank.d@gmail.com</a>
    <div class="sidebar-social">
      <a href="https://www.instagram.com/schmardware/" target="_blank" rel="noopener" aria-label="Instagram">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".5" fill="currentColor"/></svg>
      </a>
      <a href="https://www.linkedin.com/in/henryduhaime/" target="_blank" rel="noopener" aria-label="LinkedIn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="3"/><path d="M7 10v7M7 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"/></svg>
      </a>
    </div>

  </footer>
</aside>

<button
  class="motion-toggle"
  id="motion-toggle"
  aria-label="Toggle reduced motion"
  data-on="false"
>
  <span class="motion-icon">✕</span>
  <span class="motion-toggle-track"></span>
  <span class="motion-emoji">👋</span>
</button>

<script>
  import { getBadges, clearBadges, BADGE_EVENT, BADGE_RESET } from '../utils/badges.ts';

  function esc(s) {
    return String(s).replace(/[&<>"]/g, c =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  }

  function renderBadges() {
    const wrap = document.getElementById('sidebar-badges');
    const rack = document.getElementById('sidebar-badges-rack');
    if (!wrap || !rack) return;

    const badges = getBadges();
    wrap.hidden = badges.length === 0;

    rack.innerHTML = badges
      .map(b => {
        const justEarned = b.id === rack.dataset.flash ? ' is-new' : '';
        const aria = b.source ? `${b.label}, earned at ${b.source}` : b.label;
        const src = b.source
          ? `<span class="sidebar-badge-tip-src">from ${esc(b.source)}</span>`
          : '';
        const inner = `${b.icon}<span class="sidebar-badge-tip" aria-hidden="true"><span class="sidebar-badge-tip-label">${esc(b.label)}</span>${src}</span>`;
        // Link back to the minigame when we know where it came from; else a static chip.
        return b.href
          ? `<a class="sidebar-badge${justEarned}" href="${esc(b.href)}" aria-label="${esc(aria)}, revisit">${inner}</a>`
          : `<span class="sidebar-badge${justEarned}" tabindex="0" role="img" aria-label="${esc(aria)}">${inner}</span>`;
      })
      .join('');
  }

  function initReset() {
    const btn = document.getElementById('sidebar-badges-reset');
    if (!btn || btn.dataset.ready === 'true') return;
    btn.dataset.ready = 'true';
    btn.addEventListener('click', () => clearBadges());
  }

  // Briefly flag the freshly-earned badge so it can play an entrance animation.
  window.addEventListener(BADGE_EVENT, (e) => {
    const rack = document.getElementById('sidebar-badges-rack');
    if (rack && e.detail?.id) rack.dataset.flash = e.detail.id;
    renderBadges();
  });

  window.addEventListener(BADGE_RESET, () => {
    const rack = document.getElementById('sidebar-badges-rack');
    if (rack) rack.dataset.flash = '';
    renderBadges();
  });

  document.addEventListener('astro:page-load', () => { renderBadges(); initReset(); });
  renderBadges();
  initReset();

  function initToggle() {
    const btn = document.getElementById('motion-toggle') as HTMLButtonElement | null;
    if (!btn) return;

    function getReduced(): boolean {
      return document.documentElement.getAttribute('data-reduced-motion') === 'true';
    }

    function sync() {
      btn!.setAttribute('data-on', String(!getReduced()));
    }

    btn.addEventListener('click', () => {
      const next = !getReduced();
      document.documentElement.setAttribute('data-reduced-motion', String(next));
      localStorage.setItem('hank-reduced-motion', String(next));
      sync();
    });

    sync();
  }

  // Run on initial load and after each page transition
  document.addEventListener('astro:page-load', initToggle);
  initToggle();
</script>
