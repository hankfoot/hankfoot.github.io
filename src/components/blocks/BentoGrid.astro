---
import { Image } from 'astro:assets';
import { parseInline } from '../../utils/text';
import { isVideo, videoBase } from '../../utils/media';

interface Props {
  images: Array<{ src: string; alt: string; wide?: boolean; ratio?: string; width?: number; height?: number; caption?: string }>;
  /** Optional heading above the grid, styled like a Feature's label — for when
      a group of images is its own beat rather than a continuation. */
  label?: string;
}

const { images, label } = Astro.props;
---

{label && <h3 class="block-bento-label">{label}</h3>}

<div class="block-bento">
  {images.map((image) => (
    <figure class:list={['block-bento-item', { 'block-bento-item--wide': image.wide }]}>
      <div class="block-bento-cell" style={image.ratio ? `--bento-ratio: ${image.ratio}` : undefined}>
        {isVideo(image.src) ? (
          <video autoplay loop muted playsinline aria-label={image.alt}>
            <source src={`${videoBase(image.src)}.webm`} type="video/webm" />
            <source src={`${videoBase(image.src)}.mp4`} type="video/mp4" />
          </video>
        ) : (
          <Image src={image.src} alt={image.alt} width={image.width ?? 1200} height={image.height ?? 900} />
        )}
      </div>
      {image.caption && <figcaption set:html={parseInline(image.caption)} />}
    </figure>
  ))}
</div>
