---
import { Image } from 'astro:assets';
import { parseInline } from '../../utils/text';
import { isVideo, videoBase } from '../../utils/media';

interface Props {
  image: string;
  alt?: string;
  label: string;
  description: string;
  flip?: boolean;
  ratio?: string;
  /** Source credit / caption rendered under the media. Supports inline markdown. */
  caption?: string;
}

const { image, alt = '', label, description, flip = false, ratio, caption } = Astro.props;

// Images in public/ need explicit dimensions, and hardcoding 960x640 gave every
// image a 3:2 box — so a 16:9 source lost ~16% off the sides to object-fit:cover
// whatever `ratio` said. Derive the height from `ratio` instead; without one the
// old 3:2 default stands, so existing usages are unaffected.
const IMG_WIDTH = 960;
const DEFAULT_RATIO = 3 / 2;

function parseRatio(value?: string): number | null {
  if (!value) return null;
  const parts = value.split('/').map(part => parseFloat(part.trim()));
  if (parts.length === 2 && parts[0] > 0 && parts[1] > 0) return parts[0] / parts[1];
  const single = parseFloat(value);
  return Number.isFinite(single) && single > 0 ? single : null;
}

const imgHeight = Math.round(IMG_WIDTH / (parseRatio(ratio) ?? DEFAULT_RATIO));
---

<div class:list={['block-feature', { 'block-feature--flip': flip }]}>
  {/* <figure> is the grid child so a caption can sit beneath the media without
      being clipped by .block-feature-image's radius/overflow. */}
  <figure class="block-feature-figure">
    <div
      class:list={['block-feature-image', { 'block-feature-image--ratio': ratio }]}
      style={ratio ? `--feature-ratio: ${ratio}` : undefined}
    >
      {isVideo(image) ? (
        <video autoplay loop muted playsinline aria-label={alt}>
          <source src={`${videoBase(image)}.webm`} type="video/webm" />
          <source src={`${videoBase(image)}.mp4`} type="video/mp4" />
        </video>
      ) : (
        <Image src={image} alt={alt} width={IMG_WIDTH} height={imgHeight} />
      )}
    </div>
    {caption && <figcaption set:html={parseInline(caption)} />}
  </figure>
  <div class="block-feature-text">
    <h3 class="block-feature-label">{label}</h3>
    <p class="block-feature-desc">{description}</p>
  </div>
</div>
