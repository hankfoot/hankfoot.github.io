---
import { ClientRouter } from 'astro:transitions';
import Sidebar from '../components/Sidebar.astro';
import HandCursor from '../components/HandCursor.astro';
import ReducedMotionInit from '../components/ReducedMotionInit.astro';
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Hank Duhaime' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,200..500,100,1&family=Inter:ital,opsz,wght@0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700;1,14..32,400&family=Source+Code+Pro:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <ReducedMotionInit />
  <ClientRouter />
</head>
<body>
  <Sidebar transition:persist="sidebar" />
  <main class="content-area">
    <slot />
  </main>
  <HandCursor transition:persist="hand-cursor" />
</body>
</html>
