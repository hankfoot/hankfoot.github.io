---
// Standalone test page for a single game: /games/<id>
// Deliberately minimal — no sidebar, hand cursor, or view transitions — so the
// game renders in isolation and is trivial to screenshot / debug.

import { GAMES, getGame } from '../../games/manifest';
import GameCanvas from '../../components/GameCanvas.astro';

export function getStaticPaths() {
  return GAMES.map((meta) => ({ params: { game: meta.id }, props: { meta } }));
}

const { meta } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{meta.title} — game test</title>
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('hank-reduced-motion');
        var sys = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (stored === 'true' || (stored === null && sys)) {
          document.documentElement.setAttribute('data-reduced-motion', 'true');
        }
      })();
    </script>
    <style>
      :root { color-scheme: light; }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        gap: 1.5rem;
        padding: 2rem;
        box-sizing: border-box;
        background: #d9d5cc;
        font-family: system-ui, sans-serif;
        color: #2a2620;
      }
      .test-head { text-align: center; }
      .test-head h1 { margin: 0 0 0.25rem; font-size: 1.3rem; }
      .test-head p { margin: 0; opacity: 0.6; font-size: 0.85rem; }
      .test-actions {
        display: flex;
        gap: 0.75rem;
        justify-content: center;
        margin-top: 0.75rem;
      }
      .test-actions button,
      .test-actions a {
        font: inherit;
        font-size: 0.8rem;
        padding: 0.35rem 0.7rem;
        border-radius: 8px;
        border: 1px solid rgba(0, 0, 0, 0.2);
        background: #f3efe6;
        color: inherit;
        cursor: pointer;
        text-decoration: none;
      }
      .test-frame { width: min(560px, 92vw); }
    </style>
  </head>
  <body>
    <div class="test-head">
      <h1>{meta.title}</h1>
      <p>test harness · /games/{meta.id}</p>
      <div class="test-actions">
        <a href="/games/">← all games</a>
        <button type="button" id="reset-badges">reset badges</button>
      </div>
    </div>

    <div class="test-frame">
      <GameCanvas game={meta.id} bare prompt={meta.description} />
    </div>

    <script>
      import { clearBadges } from '../../utils/badges';
      document.getElementById('reset-badges')?.addEventListener('click', () => {
        clearBadges();
        location.reload();
      });
    </script>
  </body>
</html>
