---
// Standalone index of all games: /games
// Minimal, sidebar-free listing — one card per manifest entry, linking to its
// isolated test harness at /games/<id>.

import { GAMES } from '../../games/manifest';
---

<!doctype html>
<html lang="en">
  <head>
    <meta name="robots" content="noindex, nofollow" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>game tests</title>
    <style>
      :root { color-scheme: light; }
      body {
        margin: 0;
        min-height: 100vh;
        padding: 3rem 1.5rem;
        box-sizing: border-box;
        background: #d9d5cc;
        font-family: system-ui, sans-serif;
        color: #2a2620;
      }
      main { max-width: 640px; margin: 0 auto; }
      h1 { margin: 0 0 0.25rem; font-size: 1.4rem; }
      .sub { margin: 0 0 2rem; opacity: 0.6; font-size: 0.9rem; }
      ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
      a.card {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.15rem;
        border-radius: 12px;
        border: 1px solid rgba(0, 0, 0, 0.12);
        background: #f3efe6;
        color: inherit;
        text-decoration: none;
        transition: transform 0.12s ease, box-shadow 0.12s ease;
      }
      a.card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
      }
      .icon { font-size: 1.8rem; line-height: 1; }
      .meta h2 { margin: 0 0 0.15rem; font-size: 1rem; }
      .meta p { margin: 0; font-size: 0.82rem; opacity: 0.65; line-height: 1.4; }
    </style>
  </head>
  <body>
    <main>
      <h1>game tests</h1>
      <p class="sub">isolated harnesses — one page per game, no sidebar or chrome</p>
      <ul>
        {GAMES.map((meta) => (
          <li>
            <a class="card" href={`/games/${meta.id}`}>
              <span class="icon">{meta.badge?.icon ?? '🎮'}</span>
              <span class="meta">
                <h2>{meta.title}</h2>
                <p>{meta.description}</p>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>
