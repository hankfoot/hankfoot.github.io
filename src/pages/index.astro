---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import {
  aboutParagraphs,
  aboutPhoto,
  bio,
  contactLinks,
  formerly,
  experience,
  education,
  publications,
  resumeUrl,
} from '../data/about';

// Homepage running order — curated, not chronological. Anything not listed
// falls in after these, newest first, so adding a project never drops it.
const ORDER = [
  'reality-labs-prototypes',
  'quick-distract',
  'use-your-melon',
  'safecracker',
];

const slugOf = (p: { id: string }) => p.id.replace(/\.[^.]+$/, '');

const projects = await getCollection('projects', ({ data }) => !data.draft);
const sorted = projects.sort((a, b) => {
  const ia = ORDER.indexOf(slugOf(a));
  const ib = ORDER.indexOf(slugOf(b));
  if (ia !== -1 && ib !== -1) return ia - ib;   // both curated — use ORDER
  if (ia !== -1) return -1;                     // curated beats uncurated
  if (ib !== -1) return 1;
  return b.data.timeline.localeCompare(a.data.timeline); // rest: newest first
});
---
<Base title="Hank Duhaime — Design Technologist">
  <section class="page-intro">
    <h1 class="intro-title">
      <span class="intro-greeting">hi, I'm Hank <span class="intro-emoji intro-wave">👋</span></span>
    </h1>
    <p class="intro-subtitle">
      a programmer <span class="intro-emoji">💻</span> turned interaction designer,<br />
      specializing in playful, hands-on experiences <span class="intro-emoji">🕹️</span>
    </p>
    <div class="intro-formerly">
      <span class="intro-formerly-label">formerly @</span>
      {formerly.map(co => (
        <a href={co.url} target="_blank" rel="noopener">{co.name}</a>
      ))}
    </div>
  </section>

  <div class="project-grid" id="projects">
    {sorted.map(project => (
      <ProjectCard
        href={`/projects/${project.id.replace(/\.[^.]+$/, '')}`}
        title={project.data.title}
        timeline={project.data.timeline}
        tags={project.data.tags}
        thumb={project.data.thumb}
        summary={project.data.summary}
      />
    ))}
  </div>

  <section class="page-section" id="about">
    <p class="section-label">about</p>
    <div class="about-layout">
      <div class="about-prose">
        {aboutParagraphs.map(para => <p>{para}</p>)}
      </div>
      <figure class="about-photo">
        <Image src={aboutPhoto.src} alt={aboutPhoto.alt} width={1400} height={928} />
        <figcaption>{aboutPhoto.caption}</figcaption>
      </figure>
    </div>
  </section>

  <section class="page-section" id="cv">
    <p class="section-label">cv</p>
    <div class="cv-stack">

      <div class="cv-block">
        <h2 class="cv-block-label">experience</h2>
        <div class="cv-roles">
          {experience.map(role => (
            <article class="cv-role">
              <div class="cv-role-when">
                <p class="cv-role-company">{role.company}</p>
                <p class="cv-role-dates">{role.dates}</p>
              </div>
              <div class="cv-role-what">
                <p class="cv-role-title">{role.title}</p>
                <p class="cv-role-desc">{role.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>

      <div class="cv-pair">
        <div class="cv-block">
          <h2 class="cv-block-label">education</h2>
          <dl class="cv-education">
            {education.map(ed => (
              <div class="cv-education-item">
                <dt class="cv-education-school">{ed.institution}</dt>
                <dd class="cv-education-degree">{ed.degree}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="cv-block">
          <h2 class="cv-block-label">publications &amp; patents</h2>
          <ul class="cv-pubs">
            {publications.map(pub => (
              <li class="cv-pub">
                <a href={pub.link} target="_blank" rel="noopener">{pub.title}</a>
                <p class="cv-pub-meta">{pub.venue}, {pub.year}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <a href={resumeUrl} target="_blank" rel="noopener" class="section-cta">download resume ↗</a>

    </div>
  </section>

  <section class="page-section" id="contact">
    <p class="section-label">contact</p>
    <div class="contact-body">
      <p class="contact-message">{bio.contactMessage}</p>
      <ul class="contact-links">
        {contactLinks.map(link => (
          <li><a href={link.href} target={link.href.startsWith('mailto:') ? undefined : '_blank'} rel={link.href.startsWith('mailto:') ? undefined : 'noopener'}>{link.label}</a></li>
        ))}
      </ul>
    </div>
  </section>

</Base>
